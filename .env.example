# Skimatch 環境変数サンプル
# 実値は絶対にコミットしないこと（.gitignoreで.envを除外済み）。
# クライアント（Expoアプリ）に含めてよいのは EXPO_PUBLIC_ プレフィックスの変数のみ。

# --- Supabase（クライアントから利用可、匿名キーのみ） ---
# 未設定、または EXPO_PUBLIC_USE_MOCK_BACKEND=true の場合はローカルモックバックエンドで動作する。
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_USE_MOCK_BACKEND=true

# --- AI（サーバー/Edge Function専用。EXPO_PUBLIC_ を付けずクライアントへは絶対に渡さない） ---
# 未設定の場合はモックのSTT/LLM/TTSアダプタが使用され、AI機能もキー無しで確認できる。
AI_API_KEY=
AI_PROVIDER=mock

# --- Supabase サーバー専用（Edge Function実行環境のみ。クライアントバンドルに含めない） ---
SUPABASE_SERVICE_ROLE_KEY=
